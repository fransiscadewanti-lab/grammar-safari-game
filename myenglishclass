          options: ['smaller', 'smallest', 'more small', 'most small'],
          correct: 1,
          explanation: 'Small is 1 syllable! Superlative form adds -est: "Smallest".'
        },
        {
          mascot: 'fa-dragon',
          prompt: 'Transform "DANGEROUS" into a comparative adjective:',
          baseWord: 'dangerous',
          type: 'Rule 3 Transformation',
          rule: '3 Syllable Long Word',
          options: ['dangerouser', 'more dangerous', 'most dangerous', 'dangerousest'],
          correct: 1,
          explanation: 'Long words (2+ syllables) require "MORE" for comparative forms.'
        },
        {
          mascot: 'fa-smile-beam',
          prompt: 'Transform "FUNNY" into a superlative adjective:',
          baseWord: 'funny',
          type: 'Rule 2 Transformation',
          rule: 'Ends in Y',
          options: ['funnier', 'funniest', 'funnyest', 'most funny'],
          correct: 1,
          explanation: 'Change Y to I and add -est for superlative: "Funniest".'
        }
      ],
      3: [
        {
          mascot: 'fa-bolt',
          prompt: 'An elephant is __________ than a dog.',
          baseWord: 'big',
          type: 'Speed Quiz',
          rule: 'Double Consonant + er',
          options: ['biger', 'bigger', 'biggest', 'more big'],
          correct: 1,
          explanation: 'Big → Bigger! Double the "g" and add "-er".'
        },
        {
          mascot: 'fa-mountain',
          prompt: 'Mount Everest is the __________ mountain in the world.',
          baseWord: 'high',
          type: 'Speed Quiz',
          rule: 'Superlative',
          options: ['higher', 'highest', 'more high', 'most high'],
          correct: 1,
          explanation: 'Comparing Everest to all mountains: "highest".'
        },
        {
          mascot: 'fa-puzzle-piece',
          prompt: 'This grammar riddle is __________ than the last one.',
          baseWord: 'hard',
