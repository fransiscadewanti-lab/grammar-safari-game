          correct: 1,
          explanation: 'Far → Farther (or Further) for comparative distance.'
        }
      ]
    };

    function startLevel(levelNum) {
      initAudio();
      currentLevel = levelNum;
      questionIndex = 0;
      correctAnswersCount = 0;
      
      document.getElementById('screen-menu').classList.add('hidden');
      document.getElementById('screen-victory').classList.add('hidden');
      document.getElementById('screen-game').classList.remove('hidden');

      const levelTitles = {
        1: 'Level 1: Sentence Matcher',
        2: 'Level 2: Word Transformer',
        3: 'Level 3: Speed Safari Quiz'
      };
      document.getElementById('level-badge').textContent = levelTitles[levelNum];

      loadQuestion();
    }

    function loadQuestion() {
      const dataset = levelDatasets[currentLevel];
      const q = dataset[questionIndex];

      // Update Header progress
      document.getElementById('progress-text').textContent = `${questionIndex + 1} / ${dataset.length}`;
      const pct = ((questionIndex + 1) / dataset.length) * 100;
      document.getElementById('progress-bar').style.width = `${pct}%`;

      // Update Mascot & Prompt
      document.getElementById('mascot-icon').className = `fa-solid ${q.mascot}`;
      document.getElementById('rule-tag').textContent = q.type;
      document.getElementById('question-prompt').textContent = q.prompt;
      document.getElementById('base-word-highlight').textContent = q.baseWord;

      // Hide Explanation & Next button
      document.getElementById('explanation-box').classList.add('hidden');
      document.getElementById('next-btn').classList.add('hidden');

      // Build Interactive Option Buttons
      const container = document.getElementById('options-container');
      container.innerHTML = '';

      q.options.forEach((optText, idx) => {
        const btn = document.createElement('button');
        btn.className = `option-btn w-full bg-white hover:bg-sky-50 border-3 border-slate-200 text-slate-800 font-fredoka text-xl py-4 px-6 rounded-2xl shadow-md transition transform hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-between text-left`;
        btn.innerHTML = `
          <span>${optText}</span>
          <span class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-sm text-slate-400 group-hover:bg-amber-400 group-hover:text-slate-900 font-bold">${String.fromCharCode(65 + idx)}</span>
        `;
        btn.onclick = () => selectOption(idx);
        container.appendChild(btn);
      });
    }

    function selectOption(selectedIndex) {
      const dataset = levelDatasets[currentLevel];
      const q = dataset[questionIndex];
      const buttons = document.querySelectorAll('.option-btn');

      // Disable all buttons after choice
      buttons.forEach(btn => btn.disabled = true);

      if (selectedIndex === q.correct) {
        // Correct Answer
        playSound('correct');
        score += 100 + (streak * 20);
        streak += 1;
        if (streak > maxStreak) maxStreak = streak;
        correctAnswersCount += 1;

        buttons[selectedIndex].className = 'w-full bg-emerald-500 text-white font-fredoka text-xl py-4 px-6 rounded-2xl shadow-lg border-b-4 border-emerald-700 flex items-center justify-between text-left bounce-in';
        buttons[selectedIndex].innerHTML += ` <i class="fa-solid fa-circle-check text-2xl"></i>`;

        // Confetti burst on streak
        if (streak >= 3 && window.confetti) {
          confetti({ particleCount: 40, spread: 60, origin: { y: 0.7 } });
        }
      } else {
        // Incorrect Answer
        playSound('wrong');
        streak = 0;

        buttons[selectedIndex].className = 'w-full bg-rose-500 text-white font-fredoka text-xl py-4 px-6 rounded-2xl shadow-lg border-b-4 border-rose-700 flex items-center justify-between text-left shake';
        buttons[selectedIndex].innerHTML += ` <i class="fa-solid fa-circle-xmark text-2xl"></i>`;

        // Highlight correct option
        buttons[q.correct].className = 'w-full bg-emerald-100 border-2 border-emerald-500 text-emerald-900 font-fredoka text-xl py-4 px-6 rounded-2xl flex items-center justify-between text-left';
      }

      // Update HUD
      document.getElementById('score-display').textContent = score;
      document.getElementById('streak-display').textContent = streak;

      // Show Explanation Tip
      document.getElementById('explanation-text').textContent = q.explanation;
      document.getElementById('explanation-box').classList.remove('hidden');

      // Show Next Button
      document.getElementById('next-btn').classList.remove('hidden');
    }

    function nextQuestion() {
      const dataset = levelDatasets[currentLevel];
      questionIndex++;

      if (questionIndex < dataset.length) {
        loadQuestion();
      } else {
        showLevelVictory();
      }
    }

    function showLevelVictory() {
      playSound('victory');
      if (window.confetti) {
        confetti({ particleCount: 100, spread: 100, origin: { y: 0.5 } });
      }

      document.getElementById('screen-game').classList.add('hidden');
      document.getElementById('screen-victory').classList.remove('hidden');

      const dataset = levelDatasets[currentLevel];
      const accuracy = Math.round((correctAnswersCount / dataset.length) * 100);

      document.getElementById('final-score').textContent = score;
      document.getElementById('final-streak').textContent = maxStreak;
      document.getElementById('final-accuracy').textContent = `${accuracy}%`;

      const nextBtn = document.getElementById('next-level-btn');
      if (currentLevel < 3) {
        nextBtn.classList.remove('hidden');
      } else {
        nextBtn.classList.add('hidden');
      }
    }

    function playNextLevel() {
      if (currentLevel < 3) {
        startLevel(currentLevel + 1);
      } else {
        returnToMenu();
      }
    }

    function returnToMenu() {
      document.getElementById('screen-game').classList.add('hidden');
      document.getElementById('screen-victory').classList.add('hidden');
      document.getElementById('screen-menu').classList.remove('hidden');
    }

    function showCheatSheet() {
      document.getElementById('modal-cheatsheet').classList.remove('hidden');
    }

    function hideCheatSheet() {
      document.getElementById('modal-cheatsheet').classList.add('hidden');
    }
  </script>
</body>
</html>
